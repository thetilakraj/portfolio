---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FioriShowcase from '../../components/FioriShowcase.astro';
import { url } from '../../lib/url';

import radioverseLive from '../../assets/work/radioverse-live.jpg';
import radioverseDiscovery from '../../assets/work/radioverse-discovery.jpg';

export async function getStaticPaths() {
  const entries = await getCollection('work');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

/** Showcase imagery, keyed by entry. Only public, own-product work has any. */
const showcases: Record<
  string,
  { src: ImageMetadata; alt: string; caption: string }[]
> = {
  radioverse: [
    {
      src: radioverseLive,
      alt: 'Radioverse running in production — a vinyl record seated in a dark turntable plinth, tonearm resting on the groove, with live station discovery and playlist rails either side',
      caption: 'The vinyl console, live in production',
    },
    {
      src: radioverseDiscovery,
      alt: 'Radioverse discovery view showing live station browsing by genre and country alongside the player',
      caption: 'Discovery — station-first, not track-first',
    },
  ],
};

const showcase = showcases[entry.id] ?? [];

/**
 * Where a showcase image should link when clicked. Only public work with a
 * live site gets one — internal work must never carry an outbound link.
 */
const liveSite =
  d.confidentiality === 'public'
    ? d.links.find((l) => l.kind === 'site')?.href
    : undefined;

// Render the showcase as a link only when there is somewhere safe to send
// people. Internal work falls back to a plain container.
const Shot = liveSite ? 'a' : 'div';
const shotProps = liveSite
  ? {
      href: liveSite,
      target: '_blank',
      rel: 'noopener',
      'aria-label': `Open ${d.title} live in a new tab`,
    }
  : {};

/** The Fiori launchpad backdrop belongs only to the decade-long SAP study. */
const showFiori = entry.id === 'enterprise-fiori-decade';

const month = (s: string) => {
  const [y, m] = s.split('-');
  if (!m) return y;
  const name = new Date(Number(y), Number(m) - 1).toLocaleString('en', {
    month: 'short',
  });
  return `${name} ${y}`;
};

const sectorLabel = d.domain
  ? ({ fmcg: 'FMCG' } as Record<string, string>)[d.domain] ??
    d.domain[0].toUpperCase() + d.domain.slice(1)
  : undefined;

const statusLabel =
  {
    live: 'Live in production',
    'in-development': 'In development',
    'in-progress': 'In progress',
    delivered: 'Delivered',
    archived: 'Archived',
  }[d.status] ?? d.status;

const facts = [
  { label: 'Role', value: d.role },
  { label: 'At', value: d.vehicle ?? d.employer },
  { label: 'Sector', value: sectorLabel },
  {
    label: 'Period',
    value: d.end
      ? `${month(d.start)} – ${month(d.end)}`
      : `${month(d.start)} – present`,
  },
  { label: 'Status', value: statusLabel },
].filter((f): f is { label: string; value: string } => Boolean(f.value));
---

<BaseLayout bare title={`${d.title} — Tilak Raj`} description={d.summary}>
  <article>
    <!-- ============================ HEADER ============================ -->
    <header class="bloom">
      <div class="mx-auto max-w-5xl px-6 pt-12 pb-12">
        <p class="mb-6">
          <a
            href={url('/work')}
            class="font-display text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-faint no-underline hover:text-amber"
            >&larr; Work</a
          >
        </p>
        <h1 class="display display-lg max-w-[16ch]">{d.title}</h1>
        <p class="lede mt-7 max-w-[52ch]">{d.summary}</p>
      </div>
    </header>

    <!-- =========================== SHOWCASE =========================== -->
    {
      showcase.length > 0 && (
        <div class="mx-auto max-w-6xl px-6 pb-4">
          <figure class="m-0">
            <Shot
              {...shotProps}
              class="shot-link shot rounded-[10px] bg-pitch ring-1 ring-pitch-rule"
              style="box-shadow: var(--lift-lg)"
            >
              <Image
                src={showcase[0].src}
                alt={showcase[0].alt}
                widths={[720, 1080, 1600, 2000]}
                sizes="(min-width: 1152px) 1100px, 100vw"
                loading="eager"
                class="block w-full"
              />
              <span class="shot-veil" aria-hidden="true" />
              <span class="shot-cta" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>Listen live</span>
            </Shot>
            <figcaption class="eyebrow mt-4 text-center">
              {showcase[0].caption}
            </figcaption>
          </figure>
        </div>
      )
    }

    <!-- ============================= BODY ============================= -->
    <div class="mx-auto max-w-5xl px-6 pt-14">
      <div class="grid gap-x-16 gap-y-10 lg:grid-cols-[13rem_1fr]">
        <aside class="lg:sticky lg:top-24 lg:self-start">
          <dl class="m-0 border-t border-rule">
            {
              facts.map((f) => (
                <div class="border-b border-rule-soft py-3">
                  <dt class="font-display text-[0.65rem] font-semibold uppercase tracking-[0.22em] text-faint">
                    {f.label}
                  </dt>
                  <dd class="m-0 mt-1 text-[0.9rem] leading-snug text-ink">
                    {f.value}
                  </dd>
                </div>
              ))
            }
          </dl>

          {
            d.stack.length > 0 && (
              <div class="mt-7">
                <p class="mb-3 font-display text-[0.65rem] font-semibold uppercase tracking-[0.22em] text-faint">
                  Built with
                </p>
                <ul class="m-0 flex list-none flex-wrap gap-1.5 p-0">
                  {d.stack.map((s) => (
                    <li class="rounded-[3px] bg-panel px-2 py-1 font-mono text-[0.6875rem] text-plum">
                      {s}
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          {
            d.links.length > 0 && (
              <ul class="mt-7 flex list-none flex-col gap-2 p-0">
                {d.links.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      target="_blank"
                      rel="noopener"
                      class="text-[0.9rem] text-amber no-underline hover:underline"
                    >
                      {l.label} &nearr;
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </aside>

        <div>
          {
            d.outcomes.length > 0 && (
              <section class="mb-12">
                <p class="eyebrow mb-4">Measured</p>
                <ul class="grid list-none gap-4 p-0 sm:grid-cols-2">
                  {d.outcomes.map((o) => (
                    <li
                      class="rounded-[6px] border border-rule bg-surface p-5"
                      style="box-shadow: var(--lift)"
                    >
                      <p class="m-0 font-display text-[0.65rem] font-semibold uppercase tracking-[0.22em] text-faint">
                        {o.metric}
                      </p>
                      <p class="m-0 mt-2 font-display text-[1.5rem] font-black tabular-nums text-plum">
                        {o.value}
                      </p>
                      {o.note && (
                        <p class="m-0 mt-2 text-[0.85rem] leading-relaxed text-muted">
                          {o.note}
                        </p>
                      )}
                    </li>
                  ))}
                </ul>
              </section>
            )
          }

          {showFiori && <FioriShowcase />}

          <div class="spine">
            <Content />
          </div>

          {
            showcase.length > 1 && (
              <figure class="m-0 mt-14">
                <div
                  class="overflow-hidden rounded-[8px] bg-pitch ring-1 ring-pitch-rule"
                  style="box-shadow: var(--lift-lg)"
                >
                  <Image
                    src={showcase[1].src}
                    alt={showcase[1].alt}
                    widths={[640, 960, 1400]}
                    sizes="(min-width: 1024px) 700px, 100vw"
                    loading="lazy"
                    class="block w-full"
                  />
                </div>
                <figcaption class="eyebrow mt-3">
                  {showcase[1].caption}
                </figcaption>
              </figure>
            )
          }
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  /* Internal work renders <div class="shot-link">, which must never show a
     call to action or the lift. Everything else lives in global.css. */
  div.shot-link {
    transform: none !important;
    cursor: default;
  }

  div.shot-link .shot-veil,
  div.shot-link .shot-cta {
    display: none;
  }
</style>
