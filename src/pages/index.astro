---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EmployerStrip from '../components/EmployerStrip.astro';
import RadioShowcase from '../components/RadioShowcase.astro';
import { url } from '../lib/url';

const featured = (await getCollection('work'))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const statusLabel: Record<string, string> = {
  live: 'Live in production',
  'in-development': 'In development',
  'in-progress': 'In progress',
  delivered: 'Delivered',
  archived: 'Archived',
};

---

<BaseLayout
  bare
  title="Tilak Raj — SAP BTP Lead Consultant & Product Designer"
  description="Ten years designing and building software inside hard constraints — enterprise SAP delivery by day, independent consumer products by night."
>
  <!-- ============================== HERO ============================== -->
  <section class="bloom">
    <div class="mx-auto max-w-5xl px-6 pt-16 pb-10 sm:pt-24">
      <p class="eyebrow mb-6">Toronto · SAP BTP Lead Consultant</p>

      <h1 class="display display-xl max-w-[14ch]">
        Ten years inside hard constraints
      </h1>

      <p class="lede mt-8 max-w-[44ch]">
        First someone else's. Now also my own.
      </p>
    </div>

    <!-- The live product, shown and linked. -->
    <div class="mx-auto max-w-6xl px-6">
      <RadioShowcase />
    </div>
  </section>

  <!-- ============================ PILLARS ============================= -->
  <section class="mx-auto max-w-5xl px-6 pt-24">
    <div class="grid gap-x-16 gap-y-12 sm:grid-cols-2">
      <div>
        <p class="eyebrow mb-4">By day</p>
        <p class="text-[1.0625rem] leading-[1.75] text-ink">
          I lead the technical delivery of an enterprise SAP BTP platform toward
          production launch, across multiple vendor teams — readiness, code
          review, QA strategy, and the launch itself.
        </p>
        <p class="mt-4 text-sm italic text-muted">
          Technical Lead, Chicken Farmers of Ontario
        </p>
      </div>

      <div>
        <p class="eyebrow mb-4">Nights and weekends</p>
        <p class="text-[1.0625rem] leading-[1.75] text-ink">
          I design, build, and ship consumer products end to end — research,
          design system, engineering, billing, release. No handoffs, because
          there's no one to hand off to.
        </p>
        <p class="mt-4 text-sm italic text-muted">TritSync Incorp Inc.</p>
      </div>
    </div>

    <p
      class="mt-16 max-w-[62ch] border-t border-rule pt-8 text-[1.0625rem] leading-[1.8] text-muted"
    >
      The discipline is the same on both sides. Enterprise work hands you a
      design language, hard business rules, and no permission to freelance. I
      spent a decade delivering inside that — then wrote
      <em class="not-italic font-normal text-plum">stricter</em> constraints for
      myself when nobody was making me.
    </p>
  </section>

  <!-- ========================== SELECTED WORK ========================= -->
  <section class="mx-auto max-w-5xl px-6 pt-28">
    <h2 class="display display-md mb-10">Selected work</h2>

    <div class="grid gap-6">
      {
        featured.map((entry, i) => (
          <a
            href={url(`/work/${entry.id}`)}
            class:list={[
              'group relative block overflow-hidden rounded-[8px] no-underline transition-transform duration-300 hover:-translate-y-0.5',
              i === 0
                ? 'bg-pitch text-[#e9e3ee]'
                : 'border border-rule bg-surface',
            ]}
            style={i === 0 ? 'box-shadow: var(--lift-lg)' : 'box-shadow: var(--lift)'}
          >
            <div class="p-8 sm:p-10">
              <div class="mb-4 flex flex-wrap items-center gap-x-3 gap-y-1">
                <span
                  class:list={[
                    'font-display text-[0.7rem] font-semibold uppercase tracking-[0.22em]',
                    i === 0 ? 'text-amber-bright' : 'text-amber',
                  ]}
                >
                  {statusLabel[entry.data.status] ?? entry.data.status}
                </span>
                <span
                  class:list={[
                    'text-[0.7rem]',
                    i === 0 ? 'text-[#948ca0]' : 'text-faint',
                  ]}
                  aria-hidden="true"
                >
                  ·
                </span>
                <span
                  class:list={[
                    'font-display text-[0.7rem] font-semibold uppercase tracking-[0.22em]',
                    i === 0 ? 'text-[#8f8599]' : 'text-faint',
                  ]}
                >
                  {entry.data.vehicle ?? entry.data.employer}
                </span>
              </div>

              <h3
                class:list={[
                  'display display-md mb-3 transition-colors',
                  i === 0
                    ? 'text-[#f3eef6] group-hover:text-amber-bright'
                    : 'group-hover:text-amber',
                ]}
              >
                {entry.data.title}
              </h3>

              <p
                class:list={[
                  'max-w-[52ch] text-[1.0625rem] leading-[1.7]',
                  i === 0 ? 'text-[#b9afc2]' : 'text-muted',
                ]}
              >
                {entry.data.summary}
              </p>

              {entry.data.stack.length > 0 && (
                <p
                  class:list={[
                    'mt-6 font-mono text-[0.6875rem] tracking-wide',
                    i === 0 ? 'text-[#948ca0]' : 'text-faint',
                  ]}
                >
                  {entry.data.stack.join('  ·  ')}
                </p>
              )}
            </div>
          </a>
        ))
      }
    </div>

    <p class="mt-10">
      <a
        href={url('/work')}
        class="font-display text-[0.72rem] font-semibold uppercase tracking-[0.18em] text-amber no-underline hover:underline"
        >All work &rarr;</a
      >
    </p>
  </section>

  <!-- =========================== EMPLOYERS =========================== -->
  <section class="mx-auto max-w-5xl px-6 pt-28">
    <p class="eyebrow mb-6">A decade of delivery at</p>
    <EmployerStrip />
  </section>
</BaseLayout>
