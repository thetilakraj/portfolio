---
import { Font } from 'astro:assets';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { url } from '../lib/url';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  /** Wide pages (the homepage) manage their own container. */
  bare?: boolean;
}

const { title, description, image, bare = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(url(image ?? '/og-default.png'), Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Tilak Raj" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.ico')} sizes="any" />
    <meta name="theme-color" content="#efebf1" />

    <!-- Preload only Source Sans, which renders the H1. Merriweather ships in
         one reading weight and can load after first paint without competing
         with the hero image. -->
    <Font cssVariable="--font-source" preload />
    <Font cssVariable="--font-merriweather" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tilak Raj" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <slot name="head" />
  </head>

  <body class="min-h-screen">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-plum focus:px-3 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>

    <SiteHeader />

    {
      bare ? (
        <main id="main">
          <slot />
        </main>
      ) : (
        <main id="main" class="mx-auto max-w-5xl px-6 py-14">
          <slot />
        </main>
      )
    }

    <SiteFooter />
  </body>
</html>
