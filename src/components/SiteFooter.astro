---
const year = new Date().getFullYear();
---

<footer class="mt-32 bg-pitch text-[#b9afc2]">
  <div class="mx-auto max-w-5xl px-6 py-16">
    <p
      class="mb-10 max-w-[22ch] font-display text-[clamp(1.75rem,4vw,3rem)] font-black uppercase leading-[0.95] tracking-[-0.015em] text-[#f3eef6]"
    >
      Let's build something
    </p>

    <div class="flex flex-wrap items-start justify-between gap-x-12 gap-y-8">
      <div>
        <p
          class="mb-2 font-display text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-amber-bright"
        >
          Get in touch
        </p>
        <a
          href="mailto:thetilakraj@gmail.com"
          class="text-[1.05rem] text-[#e9e3ee] no-underline hover:text-amber-bright"
          >thetilakraj@gmail.com</a
        >
        <p class="mt-1 text-sm text-[#8f8599]">Toronto, Ontario</p>
      </div>

      <div>
        <p
          class="mb-2 font-display text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-amber-bright"
        >
          Elsewhere
        </p>
        <ul class="flex list-none gap-6 p-0">
          <li>
            <a
              href="https://www.linkedin.com/in/thetilakraj/"
              target="_blank"
              rel="noopener"
              class="text-[#e9e3ee] no-underline hover:text-amber-bright">LinkedIn</a
            >
          </li>
          <li>
            <a
              href="https://github.com/thetilakraj"
              target="_blank"
              rel="noopener"
              class="text-[#e9e3ee] no-underline hover:text-amber-bright">GitHub</a
            >
          </li>
        </ul>
      </div>
    </div>

    <p
      class="mt-16 border-t border-pitch-rule pt-6 font-display text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-[#948ca0]"
    >
      &copy; {year} Tilak Raj &nbsp;·&nbsp; Designed &amp; built by me
    </p>
  </div>
</footer>
