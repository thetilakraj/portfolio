---
import { Image } from 'astro:assets';
import radioverseLive from '../assets/work/radioverse-live.jpg';

/**
 * The hero: the live product, shown and linked.
 *
 * Not an iframe — listenradioverse.com sends `x-frame-options: DENY`, so no
 * browser will render it in a frame from this origin. Rather than weaken the
 * app's clickjacking protection to embed it, the whole panel is a link: the
 * real running product, one click from the real running product.
 */
const APP_URL = 'https://listenradioverse.com';
---

<figure class="m-0">
  <a
    class="shot-link panel"
    href={APP_URL}
    target="_blank"
    rel="noopener"
  >
    <!-- browser chrome: frames the screenshot as a running app -->
    <span class="bar">
      <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="addr">listenradioverse.com</span>
      <span class="pop">Open in a new tab &nearr;</span>
    </span>

    <span class="shot">
      <Image
        src={radioverseLive}
        alt="Radioverse in production: a vinyl record on a dark turntable plinth, with live station discovery and playlists"
        widths={[720, 1080, 1600, 1920]}
        sizes="(min-width: 1152px) 1100px, 100vw"
        loading="eager"
        fetchpriority="high"
        class="img"
      />
      <span class="shot-veil" aria-hidden="true"></span>
      <span class="shot-cta" aria-hidden="true">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
        Listen live
      </span>
    </span>
  </a>

  <figcaption class="cap">
    Radioverse, live in production — designed, built, and shipped solo.
  </figcaption>
</figure>

<style>
  .panel {
    border-radius: 12px;
    background: var(--pitch);
    box-shadow: var(--lift-lg);
  }

  /* ------------------------------------------------------------ chrome */
  .bar {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.6rem 0.9rem;
    background: #241f28;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .lights {
    display: flex;
    gap: 0.35rem;
    flex: none;
  }

  .lights i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #3d3545;
  }

  .lights i:first-child {
    background: color-mix(in oklab, var(--amber-bright) 70%, #3d3545);
  }

  .addr {
    flex: 1;
    min-width: 0;
    font-family: var(--mono);
    font-size: 0.7rem;
    color: #8f8599;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pop {
    flex: none;
    font-family: var(--display);
    font-weight: 600;
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--amber-bright);
    white-space: nowrap;
  }

  /* --------------------------------------------------------- the shot */
  .shot {
    position: relative;
    display: block;
    isolation: isolate;
  }

  .img {
    display: block;
    width: 100%;
    height: auto;
  }

  .cap {
    margin: 1rem 0 0;
    text-align: center;
    font-family: var(--display);
    font-weight: 600;
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--faint);
  }

</style>
